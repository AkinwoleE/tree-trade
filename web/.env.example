# Address the `papertrade` Move package is published at (testnet)
NEXT_PUBLIC_MODULE_ADDR=0x...

# Decibel node API key. Read only on the server by /api/decibel/* — not sent to the browser.
# Without it the app falls back to Hyperliquid prices automatically.
DECIBEL_NODE_API_KEY=

# Optional: Aptos node API key (avoids public rate limits)
# Never put API keys in NEXT_PUBLIC_* vars: they ship to the browser. Use server-only APTOS_API_KEY.

# Hedger service address (public) that users delegate Decibel perp trading to
NEXT_PUBLIC_HEDGER_ADDR=
# Optional Decibel package override (default: live testnet package)
# NEXT_PUBLIC_DECIBEL_PACKAGE=
# Optional hedger state file (default ../keeper/hedge-state.json)
# HEDGE_STATE_PATH=

# Per-role Geomi keys (optional; each falls back to the shared key above).
# APTOS_API_KEY_SITE=   # site server routes + /api/aptos proxy (falls back to APTOS_API_KEY)
# DECIBEL_API_KEY=      # Decibel REST/websocket (falls back to DECIBEL_NODE_API_KEY)
