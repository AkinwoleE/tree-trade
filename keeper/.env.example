# Address the papertrade package is published at (NEXT_PUBLIC_MODULE_ADDR also works)
MODULE_ADDR=0x...

# Keeper signer. Either a private key (hex or AIP-80 "ed25519-priv-0x...")...
KEEPER_PRIVATE_KEY=
# ...or a profile from an Aptos CLI config (.aptos/config.yaml). Searched in ./, ../move, ../, ~.
APTOS_PROFILE=default
# APTOS_CONFIG_PATH=/path/to/.aptos/config.yaml

# Optional: Decibel API key. Without it the keeper uses Hyperliquid.
DECIBEL_NODE_API_KEY=
# Optional: Aptos node API key
APTOS_API_KEY=

# Seconds between price pushes (oracle staleness window is 60s by default)
PUSH_INTERVAL_SECS=10

# --- Hedger (src/hedge/hedger.ts, run-hedger.sh) ---
# Service key users delegate Decibel perp trading to. Unset = mock mode (in-memory Decibel).
HEDGER_PRIVATE_KEY=
HEDGE_INTERVAL_SECS=15
# IOC price band around the Decibel mark, in bps
HEDGE_SLIPPAGE_BPS=100
# Decibel package override (default: live testnet 0xd368…7bd1)
# DECIBEL_PACKAGE=
# HEDGE_STATE_PATH=./hedge-state.json

# Per-role Geomi keys (optional; each falls back to the shared key).
# APTOS_API_KEY_BOTS=   # keeper + hedger (falls back to APTOS_API_KEY)
# DECIBEL_API_KEY=      # Decibel (falls back to DECIBEL_NODE_API_KEY)
# Usage reduction knobs: PUSH_MOVE_BPS=10 PUSH_MAX_AGE_SECS=30 SCAN_SECS=20 NEAR_LIQ_BPS=100 OI_EVERY_SECS=120 USAGE_LOG_MINS=60
